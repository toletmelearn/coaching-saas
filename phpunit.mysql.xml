<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        Four Unit files under tests/Unit/ are deliberately in no testsuite below:
        tests/Unit/ExampleTest.php, tests/Unit/Support/DatabaseVersionCheckTest.php,
        tests/Unit/Support/LoginRateLimiterTest.php, tests/Unit/Support/YoutubeUrlParserTest.php.
        None of them touches the database (plain assertions, pure string parsing, or the
        array cache), so running them against MySQL would only slow the suite — they already
        run in the SQLite suite (phpunit.xml). Decision recorded, not revisited:
        PROJECT_BRIEF.md §10 question 11. Do not re-include them.
    -->
    <testsuites>
        <testsuite name="Tenancy">
            <directory>tests/Feature/Tenancy</directory>
        </testsuite>
        <testsuite name="Auth">
            <directory>tests/Feature/Auth</directory>
        </testsuite>
        <testsuite name="Users">
            <directory>tests/Feature/Users</directory>
        </testsuite>
        <testsuite name="Courses">
            <directory>tests/Feature/Courses</directory>
        </testsuite>
        <testsuite name="Enrolments">
            <directory>tests/Feature/Enrolments</directory>
        </testsuite>
        <testsuite name="Console">
            <directory>tests/Feature/Console</directory>
        </testsuite>
        <testsuite name="Production">
            <directory>tests/Feature/Production</directory>
        </testsuite>
        <testsuite name="Video">
            <directory>tests/Feature/Video</directory>
            <directory>tests/Unit/Support/Video</directory>
        </testsuite>
        <testsuite name="Platform">
            <directory>tests/Feature/Platform</directory>
        </testsuite>
        <testsuite name="Settings">
            <directory>tests/Feature/Settings</directory>
        </testsuite>
        <testsuite name="Pwa">
            <directory>tests/Feature/Pwa</directory>
            <directory>tests/Unit/Support/Pwa</directory>
        </testsuite>
        <testsuite name="Progress">
            <directory>tests/Feature/Progress</directory>
            <directory>tests/Unit/Support/Progress</directory>
        </testsuite>
        <testsuite name="Devices">
            <directory>tests/Feature/Devices</directory>
            <directory>tests/Unit/Support/Devices</directory>
        </testsuite>
        <testsuite name="Import">
            <directory>tests/Feature/Import</directory>
        </testsuite>
        <testsuite name="Dashboard">
            <directory>tests/Feature/Dashboard</directory>
        </testsuite>
        <testsuite name="Help">
            <directory>tests/Feature/Help</directory>
        </testsuite>
        <testsuite name="MobileGuards">
            <directory>tests/Feature/MobileGuards</directory>
            <directory>tests/Unit/Support/MobileGuards</directory>
        </testsuite>
        <testsuite name="Payments">
            <directory>tests/Feature/Payments</directory>
        </testsuite>
        <testsuite name="Actions">
            <directory>tests/Unit/Actions</directory>
        </testsuite>
        <testsuite name="Config">
            <directory>tests/Unit/Config</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
