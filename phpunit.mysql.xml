<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Tenancy">
            <directory>tests/Feature/Tenancy</directory>
        </testsuite>
        <testsuite name="Auth">
            <directory>tests/Feature/Auth</directory>
        </testsuite>
        <testsuite name="Users">
            <directory>tests/Feature/Users</directory>
        </testsuite>
        <testsuite name="Courses">
            <directory>tests/Feature/Courses</directory>
        </testsuite>
        <testsuite name="Enrolments">
            <directory>tests/Feature/Enrolments</directory>
        </testsuite>
        <testsuite name="Console">
            <directory>tests/Feature/Console</directory>
        </testsuite>
        <testsuite name="Production">
            <directory>tests/Feature/Production</directory>
        </testsuite>
        <testsuite name="Video">
            <directory>tests/Feature/Video</directory>
            <directory>tests/Unit/Support/Video</directory>
        </testsuite>
        <testsuite name="Platform">
            <directory>tests/Feature/Platform</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
