includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    level: 5

    tmpDir: storage/framework/phpstan

    ignoreErrors:
        # BelongsToTenant trait is used only by test fixtures until Phase 3 when product models are introduced
        - identifier: trait.unused
          path: app/Traits/BelongsToTenant.php
