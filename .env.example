APP_NAME="Coaching SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PLATFORM_DOMAIN=coaching.test
TENANT_BASE_DOMAIN=coaching.test
CENTRAL_DOMAINS=localhost,127.0.0.1,coaching.test,platform.coaching.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coaching_saas
DB_USERNAME=root
DB_PASSWORD=

# Backup dump binaries. Installed by XAMPP but not on this machine's PATH.
# On Windows, gzip is also needed if you want compressed database dumps —
# install via `choco install gzip` in an Administrator shell. In local
# environments the backup compressor defaults to null (no gzip needed);
# production uses gzip compression.
# Leave blank on Linux = use PATH (correct there).
SQLITE_DUMP_BINARY_PATH=
MYSQL_DUMP_BINARY_PATH=

# Used only by `composer test:mysql` (see README.md)
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=coaching_saas_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=

SESSION_DRIVER=database
# 30 days (Phase 8) — students aren't logged out every two hours; see SECURITY.md.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (see docs/DEPLOY.md) — never set SESSION_DOMAIN to anything but
# null/empty (SECURITY.md: a shared cookie domain would defeat tenant session isolation).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where spatie/laravel-backup health alerts go; blank falls back to MAIL_FROM_ADDRESS.
BACKUP_NOTIFY_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Local/testing default — production MUST be `bunny`: `app:preflight` refuses `fake` under APP_ENV=production, and bunny is the only supported production driver (docs/specs/phase-5-video.md).
VIDEO_DRIVER=fake
# Bunny Stream ACCOUNT-level API key (per-tenant library keys live encrypted on tenants); required by `app:preflight` when VIDEO_DRIVER=bunny.
BUNNY_STREAM_ACCOUNT_API_KEY=

# Live classes (Phase 12, docs/LIVE_CLASSES.md). Off by default: with LIVE_CLASSES_ENABLED=false every live-class route 404s and the dashboard/course sections render nothing.
LIVE_CLASSES_ENABLED=false
# JaaS (8x8.vc) credentials — required by `app:preflight` whenever LIVE_CLASSES_ENABLED=true (Decision A). Used only to sign the short-lived join JWT server-side.
JITSI_APP_ID=
JITSI_APP_SECRET=
# Default-off disclosure flag (Decision B): renders the "may be recorded" notice only when a paid JaaS recording add-on is actually attached.
LIVE_CLASSES_RECORDING_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
