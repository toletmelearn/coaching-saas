APP_NAME="Coaching SaaS"
APP_ENV=production
APP_KEY=                          # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://PLATFORM_DOMAIN
PLATFORM_DOMAIN=PLATFORM_DOMAIN
TENANT_BASE_DOMAIN=PLATFORM_DOMAIN
# Comma-separated list of hostnames that are NEVER looked up in tenant_domains.
# Must include at least the bare domain and the platform/admin subdomain.
# SESSION_DOMAIN must remain null regardless (see SECURITY.md).
CENTRAL_DOMAINS=PLATFORM_DOMAIN,platform.PLATFORM_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coaching_saas
DB_USERNAME=coaching_saas
DB_PASSWORD=

# Leave blank — only needed when mysqldump/pg_dump are not on PATH.
SQLITE_DUMP_BINARY_PATH=
MYSQL_DUMP_BINARY_PATH=

SESSION_DRIVER=database
# 30 days — students aren't logged out every two hours (see SECURITY.md).
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
# Must be null/empty — a non-null value would share session cookies across tenant
# subdomains, defeating tenant isolation (SECURITY.md). app:preflight enforces this.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use `database` for managed VPS; upgrade to `redis` when Redis is available.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@PLATFORM_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# Alert email for spatie/laravel-backup. Falls back to MAIL_FROM_ADDRESS when blank.
BACKUP_NOTIFY_EMAIL=
# Required in production — store the password separately from the backup files.
# app:preflight warns when this is blank (a backup without a password is plaintext).
BACKUP_ARCHIVE_PASSWORD=

# Production MUST be `bunny`. `fake` is refused by app:preflight under APP_ENV=production.
VIDEO_DRIVER=bunny
# Platform-level account API key from Bunny.net account settings.
# Per-tenant library keys are generated and stored encrypted by the app — never set here.
BUNNY_STREAM_ACCOUNT_API_KEY=

# Phase 12. Off by default — flip to `true` only after setting both JaaS keys below.
# app:preflight fails production when this is `true` with either key missing.
LIVE_CLASSES_ENABLED=false
LIVE_CLASSES_RECORDING_ENABLED=false
# Required only when LIVE_CLASSES_ENABLED=true:
JITSI_APP_ID=
JITSI_APP_SECRET=

VITE_APP_NAME="${APP_NAME}"
